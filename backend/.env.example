# Copy this file to .env and fill in your own values.
# .env is gitignored — it never gets committed.

# MySQL credentials for the placement_records_db database
DB_USERNAME=root
DB_PASSWORD=

# Gmail account used to send selection/welcome emails.
# MAIL_PASSWORD must be a 16-character Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT your normal Gmail login password.
MAIL_USERNAME=
MAIL_PASSWORD=
